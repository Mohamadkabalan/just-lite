APP_NAME="Just Lite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_Languages=ar
Fallback_Languages=ar

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The DB_* values are set by docker-compose.yml and override these.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=u702536597_justlite_db
DB_USERNAME=justlite
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
