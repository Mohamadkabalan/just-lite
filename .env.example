# Copy to .env and fill in. These defaults are safe for the live site; for
# local development set APP_ENV=local, APP_DEBUG=true and APP_URL to your
# local address. DEPLOYMENT.md ("Server settings") explains each value.

APP_NAME="Just Lite"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://just-lite.com

# Default and fallback language (the site's Arabic pages are at the root).
APP_Languages=ar
Fallback_Languages=ar

# Canonical host for canonical links, hreflang and the sitemap.
SITE_URL=https://just-lite.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Only send the session cookie over HTTPS (set to false for plain-HTTP local setups).
SESSION_SECURE_COOKIE=true
BCRYPT_ROUNDS=12

# Outgoing mail (booking and contact notifications, error alerts).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Who receives new bookings and messages (default: the address on the site).
# NOTIFY_EMAIL=someone@example.com
# Who receives error reports (empty: no alerts).
# ERROR_EMAIL=developer@example.com
# Google Tag Manager, loaded only after a visitor accepts analytics cookies.
GTM_ID=GTM-MNGKCWV
